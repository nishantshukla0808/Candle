    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "license": "UNLICENSED",
  "name": "@candle/api",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test --max-warnings=0",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsc -p tsconfig.seed.json && node dist-seed/prisma/seed.js",
    "prisma:studio": "prisma studio",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "test": "jest --config test/jest.json",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand --detectOpenHandles",
    "test:watch": "jest --config test/jest.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build --workspace=@candle/shared",
    "prelint": "npm run build --workspace=@candle/shared",
    "pretypecheck": "npm run build --workspace=@candle/shared",
    "pretest": "npm run build --workspace=@candle/shared",
    "pretest:e2e": "npm run build --workspace=@candle/shared"
  },
  "prisma": {
    "seed": "npm run prisma:seed"
  },
  "version": "0.0.0"
}
